{{#> layouts/base 
    title="Verify Your Email"
    headerIcon="✅" 
    headerTitle="Verify Your Email"
    headerColor="#059669"
    buttonColor="#059669"
}}

<div class="card">
    <h2>Hello {{name}},</h2>
    <p>Welcome to MedipointHQ. Please verify your email address to activate your account and start booking consultations.</p>
    
    {{> button url=verificationUrl text="Verify Email Address" arrow=true}}
    
    <div class="success">
        <p><strong>📧 Almost done!</strong></p>
        <ul>
            <li>This verification link expires in <strong>{{expiryHours}} hours</strong></li>
            <li>Click the button above to confirm your email address</li>
            <li>Once verified, you'll have full access to book and manage consultations</li>
        </ul>
    </div>
</div>

<div class="card">
    <h3>🔐 Why verify your email?</h3>
    <ul>
        <li>Secure your account and enable password recovery</li>
        <li>Receive appointment confirmations and consultation reminders</li>
        <li>Get notified when a healthcare professional responds to you</li>
        <li>Ensure uninterrupted access to your health records and consultations</li>
    </ul>
</div>

{{/layouts/base}}