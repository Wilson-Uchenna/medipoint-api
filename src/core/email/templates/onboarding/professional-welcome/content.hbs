{{#> layouts/base 
    title="Welcome to {{organizationName}}"
    headerIcon="👩‍⚕️" 
    headerTitle="Welcome to {{organizationName}}"
    headerColor="#0284c7"
    buttonColor="#0284c7"
}}

<div class="card">
    <h2>Hello {{providerName}},</h2>
    <p>Welcome to {{organizationName}}! We are thrilled to welcome you to our medical staff and clinical community.</p>
    <p>🎉 Your secure clinician portal account has been successfully provisioned. You can now access your clinical dashboard, roster, and compliance tools.</p>
    
    {{> button url=loginUrl text="Access Your Provider Portal" arrow=true}}
</div>

<div class="card">
    <h3>Get Started</h3>
    <ol>
        <li>Activate your account — log in and set your secure credentials</li>
        <li>Complete your provider profile — verify your active clinical credentials, licenses, and specialties</li>
        <li>Set up directory preferences — configure how your profile appears in public and internal patient-facing directories</li>
        {{#if activationDeadline}}
        <li>Complete compliance training — please finish your required HIPAA and safety modules before {{formatDate activationDeadline 'MMMM Do, YYYY'}}</li>
        {{/if}}
    </ol>
</div>

{{#if supportEmail}}
<div class="highlight">
    <p><strong>Need help?</strong> Contact our medical staff services team at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.</p>
</div>
{{else if supportUrl}}
<div class="highlight">
    <p><strong>Need help?</strong> Visit our <a href="{{supportUrl}}">provider support center</a>.</p>
</div>
{{/if}}

{{#if unsubscribeUrl}}
<div class="warning">
    <p><small>© {{currentYear}} {{#if companyName}}{{companyName}}{{else}}{{organizationName}}{{/if}}. Don't want these emails? <a href="{{unsubscribeUrl}}">Unsubscribe</a>. All rights reserved.</small></p>
    <p><small><em>Confidentiality Notice: This transmission is intended for healthcare professionals only and may contain privileged or protected health information (PHI).</em></small></p>
</div>
{{/if}}

{{/layouts/base}}