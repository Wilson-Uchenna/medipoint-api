{
  "name": "provider-approval-confirmed",
  "description": "Approval confirmation email sent to healthcare providers once their credentialing/account application has been reviewed and approved",
  "category": "onboarding",
  "tags": ["approval", "provider", "account", "medical-staff", "credentialing"],
  "version": "1.0.0",
  "subject": "Your {{organizationName}} Provider Account Has Been Approved ✅",
  "requiredVariables": [
    "providerName",
    "organizationName",
    "loginUrl",
    "currentYear"
  ],
  "optionalVariables": [
    "approvalDate",
    "specialty",
    "licenseNumber",
    "npiNumber",
    "companyName",
    "supportEmail",
    "supportUrl",
    "unsubscribeUrl",
    "customFooter"
  ],
  "defaultData": {
    "headerIcon": "✅",
    "headerColor": "#16a34a",
    "buttonColor": "#16a34a",
    "currentYear": "{{currentYear}}",
    "supportUrl": "https://medicalorg.com"
  }
}